  "info": {
    "title": "API Documentation",
    "description": "Swagger docs for the project",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "description": "Tên đăng nhập của người dùng"
          },
          "password": {
            "type": "string",
            "description": "Mật khẩu của người dùng"
          }
        },
        "required": [
          "username",
          "password"
        ]
      },
      "ResponseAuthDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "Access token trả về sau khi đăng nhập hoặc refresh"
          },
          "refreshToken": {
            "type": "string",
            "description": "Refresh token đi kèm với access token"
          }
        }
      },
      "LogoutResponse": {
        "type": "object",
        "properties": {}
      },
      "RegisterDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "description": "Tên đăng nhập",
            "example": "johndoe"
          },
          "email": {
            "type": "string",
            "description": "Email",
            "example": "abc@def.xyz"
          },
          "password": {
            "type": "string",
            "description": "Mật khẩu mạnh (tối thiểu 8 ký tự, 1 số, 1 chữ in hoa, 1 ký tự đặc biệt)",
            "example": "StrongP@ssw0rd"
          },
          "roles": {
            "type": "array",
            "description": "Danh sách role (ADMIN, USER)",
            "items": {
              "type": "string",
              "enum": [
                "user",
                "admin",
                "moderator"
              ]
            }
          }
        },
        "required": [
          "username",
          "email",
          "password"
        ]
      },
      "ForgotPasswordDto": {
        "type": "object",
        "properties": {}
      },
      "OtpResponseDto": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "description": "OTP code sent to the user"
          }
        }
      },
      "OtpCodeDto": {
        "type": "object",
        "properties": {}
      },
      "VerifyOtpResponseDto": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "description": "Message indicating the result of the OTP verification"
          },
          "isValid": {
            "type": "boolean",
            "description": "Indicates whether the OTP verification was successful"
          },
          "resetPasswordToken": {
            "type": "string",
            "description": "Token to be used for reset password"
          }
        }
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {
          "newPassword": {
            "type": "string",
            "description": "Mật khẩu mạnh (tối thiểu 8 ký tự, 1 số, 1 chữ in hoa, 1 ký tự đặc biệt)",
            "example": "StrongP@ssw0rd"
          },
          "resetPasswordToken": {
            "type": "string",
            "description": "Token to be used for reset password",
            "example": "hashed-reset-password-token"
          }
        },
        "required": [
          "newPassword",
          "resetPasswordToken"
        ]
      },
      "ResetPasswordResponse": {
        "type": "object",
        "properties": {}
      },
      "CreateProfileDto": {
        "type": "object",
        "properties": {}
      },
      "UpdateProfileDto": {
        "type": "object",
        "properties": {}
      },
      "ListUserIdDto": {
        "type": "object",
        "properties": {}
      },
      "CreateEventDto": {
        "type": "object",
        "properties": {}
      },
      "RSVPDto": {
        "type": "object",
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "owner",
              "invited",
              "accepted",
              "interested",
              "rejected",
              "pending",
              "none"
            ]
          }
        },
        "required": [
          "state"
        ]
      },
      "InviteMemberDto": {
        "type": "object",
        "properties": {}
