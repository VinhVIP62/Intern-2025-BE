{
	"openapi": "3.0.0",
	"paths": {
		"/api/v1/client/auth/login": {
			"post": {
				"description": "Đăng nhập tài khoản người dùng",
				"operationId": "AuthController_login_v1",
				"parameters": [],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/LoginDto"
							}
						}
					}
				},
				"responses": {
					"200": {
						"description": "Login thành công",
						"content": {
							"application/json": {
								"schema": {
									"allOf": [
										{
											"$ref": "#/components/schemas/Response"
										},
										{
											"type": "object",
											"properties": {
												"data": {
													"$ref": "#/components/schemas/ResponseAuthDto"
												}
											}
										}
									]
								}
							}
						}
					}
				},
				"summary": "Login user",
				"tags": ["Auth"]
			}
		},
		"/api/v1/client/auth/register": {
			"post": {
				"description": "Đăng ký tài khoản mới",
				"operationId": "AuthController_register_v1",
				"parameters": [],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/RegisterDto"
							}
						}
					}
				},
				"responses": {
					"201": {
						"description": "Đăng ký thành công",
						"content": {
							"application/json": {
								"schema": {
									"allOf": [
										{
											"$ref": "#/components/schemas/Response"
										},
										{
											"type": "object",
											"properties": {
												"data": {
													"$ref": "#/components/schemas/ResponseAuthDto"
												}
											}
										}
									]
								}
							}
						}
					}
				},
				"summary": "Register user",
				"tags": ["Auth"]
			}
		},
		"/api/v1/client/auth/refresh": {
			"post": {
				"description": "Cấp lại access token từ refresh token",
				"operationId": "AuthController_refreshToken_v1",
				"parameters": [],
				"responses": {
					"200": {
						"description": "Xác thực refresh token thành công. Trả về access token.",
						"content": {
							"application/json": {
								"schema": {
									"allOf": [
										{
											"$ref": "#/components/schemas/Response"
										},
										{
											"type": "object",
											"properties": {
												"data": {
													"type": "object",
													"properties": {
														"accessToken": {
															"type": "string",
															"description": "Access token mới"
														}
													}
												}
											}
										}
									]
								}
							}
						}
					}
				},
				"security": [
					{
						"refreshTokenAuth": []
					}
				],
				"summary": "Refresh token",
				"tags": ["Auth"]
			}
		}
	},
	"info": {
		"title": "API Documentation",
		"description": "Swagger docs for the project",
		"version": "1.0",
		"contact": {}
	},
	"tags": [],
	"servers": [],
	"components": {
		"securitySchemes": {
			"refreshTokenAuth": {
				"type": "http",
				"scheme": "bearer",
				"bearerFormat": "JWT",
				"description": "Use Bearer {refreshToken} in the Authorization header"
			},
			"accessTokenAuth": {
				"type": "http",
				"scheme": "bearer",
				"bearerFormat": "JWT",
				"description": "Use Bearer {refreshToken} in the Authorization header"
			}
		},
