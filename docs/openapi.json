												}
											}
										}
									]
								}
							}
						}
					}
				},
				"security": [
					{
						"accessTokenAuth": []
					}
				],
				"tags": ["Profile"]
			}
		},
		"/api/v1/client/posts": {
			"post": {
				"tags": ["Social post"],
				"summary": "Create a new post",
				"security": [
					{
						"accessTokenAuth": []
					}
				],
				"requestBody": {
					"required": true,
					"content": {
						"multipart/form-data": {
