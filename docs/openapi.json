								"$ref": "#/components/schemas/CreatePostDto"
							}
						}
					}
				},
				"responses": {
					"201": {
						"description": "Tạo bài viết thành công",
						"content": {
							"application/json": {
								"schema": {
									"allOf": [
										{
											"$ref": "#/components/schemas/Response"
										},
										{
											"type": "object",
											"properties": {
												"data": {
													"$ref": "#/components/schemas/ResponsePostDto"
												}
											}
										}
									]
								}
							}
						}
					}
				}
			}
		},
		"/api/v1/client/posts/{id}": {
			"delete": {
				"tags": ["Social post"],
				"summary": "Delete a post by ID",
				"security": [
					{
						"accessTokenAuth": []
					}
				],
				"parameters": [
					{
						"name": "id",
						"in": "path",
						"required": true,
						"description": "ID bài viết cần xóa",
						"schema": {
							"type": "string"
						}
					}
				],
				"responses": {
					"200": {
						"description": "Xóa bài viết thành công",
						"content": {
							"application/json": {
								"schema": {
									"allOf": [
										{
											"$ref": "#/components/schemas/Response"
										},
										{
											"type": "object",
											"properties": {
												"data": {
													"$ref": "#/components/schemas/ResponsePostDto"
												}
											}
										}
									]
								}
							}
						}
					}
				}
			},
			"patch": {
				"tags": ["Social post"],
				"summary": "Update a post by ID",
				"security": [
					{
						"accessTokenAuth": []
					}
				],
				"parameters": [
					{
						"name": "id",
						"in": "path",
						"required": true,
						"description": "ID bài viết cần cập nhật",
						"schema": {
							"type": "string"
						}
					}
				],
				"requestBody": {
					"required": true,
					"content": {
						"multipart/form-data": {
							"schema": {
								"$ref": "#/components/schemas/UpdatePostDto"
							}
						}
					}
				},
				"responses": {
					"200": {
						"description": "Cập nhật bài viết thành công",
						"content": {
							"application/json": {
								"schema": {
									"allOf": [
										{
											"$ref": "#/components/schemas/Response"
										},
										{
											"type": "object",
											"properties": {
												"data": {
													"$ref": "#/components/schemas/ResponsePostDto"
												}
											}
										}
									]
								}
							}
						}
					}
				}
			},
			"get": {
				"tags": ["Social post"],
				"summary": "Get a post by ID",
				"security": [
					{
						"accessTokenAuth": []
					}
				],
				"parameters": [
					{
						"name": "id",
						"in": "path",
						"required": true,
						"description": "ID bài viết cần lấy",
						"schema": {
							"type": "string"
						}
					}
				],
				"responses": {
					"200": {
						"description": "Lấy bài viết thành công",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Response"
								}
							}
						}
					}
				}
			}
		},
		"/api/v1/client/posts/feed": {
			"get": {
				"tags": ["Social post"],
				"summary": "Get feed posts with pagination",
				"security": [
					{
						"accessTokenAuth": []
					}
				],
				"parameters": [
					{
						"name": "cursor",
						"in": "query",
						"required": false,
						"description": "ID bài viết cuối cùng để phân trang",
						"schema": {
							"type": "string"
						}
					},
					{
						"name": "limit",
						"in": "query",
						"required": false,
						"description": "Số lượng bài viết tối đa trả về",
						"schema": {
							"type": "integer",
							"minimum": 1,
							"default": 10
						}
					}
				],
				"responses": {
					"200": {
						"description": "Lấy feed bài viết thành công",
						"content": {
							"application/json": {
								"schema": {
									"allOf": [
										{
											"$ref": "#/components/schemas/CursorPaginatedResponse"
										},
										{
											"type": "object",
											"properties": {
												"data": {
													"type": "array",
													"items": { "$ref": "#/components/schemas/ResponsePostDto" }
												}
											}
										}
									]
								}
							}
						}
					}
				}
			}
		}
	},
	"info": {
		"title": "ASOCIO☄ API Documentation",
		"description": "Swagger docs for ASOCIO endpoints.",
		"version": "0.1.1",
		"contact": {
			"email": "dang.nguyen106@hcmut.edu.vn",
			"url": "https://github.com/D-ng7721",
			"name": "D-ng7721"
		}
	},
	"tags": [],
	"servers": [],
	"components": {
		"securitySchemes": {
			"refreshTokenAuth": {
				"type": "http",
				"scheme": "bearer",
				"bearerFormat": "JWT",
				"description": "Gán giá trị \"Bearer {refreshToken}\" trong Authorization header"
			},
			"accessTokenAuth": {
				"type": "http",
				"scheme": "bearer",
				"bearerFormat": "JWT",
				"description": "Gán giá trị \"Bearer {accessToken}\" trong Authorization header"
			}
		},
		"schemas": {
			"Response": {
				"type": "object",
				"title": "ResponseEntity",
				"description": "Cấu trúc phản hồi API chuẩn",
				"properties": {
					"path": {
						"type": "string",
						"description": "Đường dẫn API",
						"example": "/api/v1/dev/all-users"
					},
					"statusCode": {
						"type": "number",
						"description": "HTTP status code",
						"example": 200
					},
					"success": {
						"type": "boolean",
						"description": "true nếu không có lỗi, false nếu có lỗi"
					},
					"timestamp": {
						"oneOf": [
							{ "type": "string", "format": "date-time" },
							{ "type": "string" },
							{ "type": "number" }
						],
						"description": "Thời điểm trả response",
						"example": 1751271347625
					},
					"error": {
						"oneOf": [
							{
								"type": "string",
								"description": "Thông báo lỗi"
							},
							{
								"type": "object",
								"additionalProperties": {
									"type": "string"
								},
								"description": "Danh sách key-value các field bị lỗi và thông báo lỗi",
								"example": {
									"username": "username already existed inside the database",
									"mail": "mail already existed inside the database"
								}
							}
						],
						"description": "Error message nếu có",
						"nullable": true
					},
					"data": {
						"type": "object",
						"description": "Response data; có giá trị null nếu có error"
					}
				},
				"required": ["path", "statusCode", "success", "timestamp", "data"]
			},
			"PaginatedResponse": {
				"type": "object",
				"title": "PaginatedResponseEntity",
				"description": "Cấu trúc phản hồi API cho dữ liệu phân trang chuẩn",
				"allOf": [
					{
						"$ref": "#/components/schemas/Response"
					},
					{
						"type": "object",
						"properties": {
							"page": {
								"type": "number",
								"description": "Trang hiện tại"
							},
							"amount": {
								"type": "number",
								"description": "Số kết quả trả về"
							}
						}
					}
				],
				"required": ["page", "amount"]
			},
			"CursorPaginatedResponse": {
				"type": "object",
				"title": "CursorPaginatedResponseEntity",
				"description": "Cấu trúc phản hồi API cho dữ liệu phân trang sử dụng cursor chuẩn",
				"allOf": [
					{
						"$ref": "#/components/schemas/Response"
					},
					{
						"type": "object",
						"properties": {
							"cursor": {
								"type": "string",
								"description": "Cursor để query trang tiếp theo"
							},
							"amount": {
								"type": "number",
								"description": "Số kết quả trả về"
							}
						}
					}
				],
				"required": ["cursor", "amount"]
			},
			"LoginDto": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string",
						"description": "Số điện thoại (Bắt đầu bằng dấu + và mã quốc tế +XX) hoặc email người dùng.",
						"example": "+84369963369"
					},
					"password": {
						"type": "string",
						"description": "Mật khẩu của người dùng",
						"example": "StrongP@ssw0rd"
					}
				},
				"required": ["id", "password"]
			},
			"RegisterDto": {
				"type": "object",
				"allOf": [
					{
						"$ref": "#/components/schemas/CreateUserDto"
					}
				]
			},
			"ResponseAuthDto": {
				"type": "object",
				"properties": {
					"accessToken": {
						"type": "string",
						"description": "Access token trả về sau khi đăng nhập hoặc refresh"
					},
					"refreshToken": {
						"type": "string",
						"description": "Refresh token đi kèm với access token"
					}
				}
			},
			"CreateUserDto": {
				"type": "object",
				"properties": {
					"username": {
						"type": "string",
						"example": "john_doe"
					},
					"password": {
						"type": "string",
						"format": "password",
						"description": "Strong password required"
					},
					"mail": {
						"type": "string",
						"format": "email",
						"example": "john@example.com"
					},
					"phone": {
						"type": "string",
						"example": "+1234567890"
					}
				},
				"required": ["username", "password", "mail", "phone"],
				"additionalProperties": false
			},
			"PartialCreateUserDto": {
				"type": "object",
				"properties": {
					"username": {
						"type": "string",
						"example": "john_doe"
					},
					"password": {
						"type": "string",
						"format": "password",
						"description": "Strong password required"
					},
					"mail": {
						"type": "string",
						"format": "email",
						"example": "john@example.com"
					},
					"phone": {
						"type": "string",
						"example": "+1234567890"
					}
				},
				"additionalProperties": false
			},
			"UpdateUserDto": {
				"allOf": [
					{
						"$ref": "#/components/schemas/PartialCreateUserDto"
					},
					{
						"type": "object",
						"properties": {
							"avatar": {
								"type": "string",
								"format": "binary",
								"description": "Avatar file. Đuôi png/jpg/jpeg/gif"
							},
							"location": {
								"$ref": "#/components/schemas/LocationDto"
							},
							"sports": {
								"type": "array",
								"items": { "$ref": "#/components/schemas/SportDto" }
							}
						}
					}
				]
			},
			"SetupUserDto": {
				"type": "object",
				"properties": {
					"avatar": {
						"type": "string",
						"format": "binary",
						"description": "Avatar file. Đuôi png/jpg/jpeg/gif"
					},
					"location": {
						"$ref": "#/components/schemas/Location"
					},
					"sports": {
						"type": "array",
						"items": {
							"$ref": "#/components/schemas/Sport"
						},
						"uniqueItems": true
					}
				},
				"required": ["avatar", "location", "sports"],
				"additionalProperties": false
