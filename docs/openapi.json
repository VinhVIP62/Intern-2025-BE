						}
					}
				},
				"responses": {
					"200": {
						"description": "Login thành công",
						"content": {
							"application/json": {
								"schema": {
									"allOf": [
										{
											"$ref": "#/components/schemas/Response"
										},
										{
											"type": "object",
											"properties": {
												"data": {
													"$ref": "#/components/schemas/ResponseAuthDto"
												}
											}
										}
									]
								}
							}
						}
					}
				},
				"summary": "Login user",
				"tags": ["Auth"]
			}
		},
